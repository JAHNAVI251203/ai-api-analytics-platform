POSTGRES_PASSWORD=replace_with_a_postgres_password
REDIS_PASSWORD=replace_with_a_redis_password
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
REDIS_URL=redis://:password@localhost:6379

PORT=8000
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins allowed to call the API and Socket.IO server.
CORS_ORIGIN=http://localhost:3000
# Comma-separated exact hosts or wildcard domains permitted for alert webhooks.
# Example: hooks.example.com,*.webhook.site. Empty disables outgoing webhooks.
WEBHOOK_ALLOWED_HOSTS=webhook.site
# Email address permitted to access /admin/queues. Leave unset to deny access.
ADMIN_EMAIL=admin@example.com

GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
INGESTION_API_KEY=replace_with_a_long_random_ingestion_key
